# موقع سيارات مجمع الثمامة على Hostinger
Options -Indexes
DirectoryIndex index.html

# الموقع صفحة واحدة: أي رابط غير موجود يفتح index.html (ما عدا واجهة الخادم /api)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # الموقع الجغرافي مسموح لصفحة السائق فقط من هذا الموقع
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # الصفحة تُحدَّث دائمًا، وملفات assets تحمل بصمة في اسمها فتُخزَّن طويلًا
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
