rules_version = '2';

// قواعد الوصول حسب الدور:
// - لا يُقرأ أو يُكتب أي شيء إلا بحساب مسجل له ملف في users بحالة active.
// - الدور يُقرأ من ملف المستخدم في قاعدة البيانات، ولا يستطيع المستخدم تغييره بنفسه.
// - المدير (admin) وحده يدير المستخدمين وبيانات السيارات.
// - حساب المدير الأول يُنشأ مرة واحدة فقط (مستند meta/setup يمنع تكرار ذلك).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }
    function hasRole(roles) { return isStaff() && profile().role in roles; }
    function isAdmin() { return hasRole(['admin']); }
    // موظفو المكتب: كل الأدوار ما عدا السائق (السائق لا يرى بيانات المرضى)
    function isOffice() { return hasRole(['admin', 'clinic', 'buildingSupervisor', 'fleetSupervisor']); }

    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }
    function setupDoneAfter() { return existsAfter(/databases/$(database)/documents/meta/setup); }

    // حد أقصى لعدد حقول مستندات البيانات التشغيلية
    function reasonableSize() { return request.resource.data.size() <= 40; }

    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9][a-z0-9._-]{2,31}$');
    }
    function validProfile(data, uid) {
      return data.keys().hasOnly(['username', 'displayName', 'role', 'active', 'mustChangePassword', 'vehiclePlate', 'createdAt', 'createdBy'])
        && data.keys().hasAll(['username', 'displayName', 'role', 'active', 'mustChangePassword'])
        && validUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.role in ['admin', 'clinic', 'buildingSupervisor', 'fleetSupervisor', 'driver']
        && (data.role != 'driver' || (data.get('vehiclePlate', null) is string && data.vehiclePlate.size() > 0))
        && data.active is bool
        && data.mustChangePassword is bool
        // اسم المستخدم يجب أن يشير إلى هذا الحساب نفسه
        && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == uid;
    }

    // ملفات المستخدمين والأدوار
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if validProfile(request.resource.data, uid) && (
        isAdmin()
        // إنشاء المدير الأول مرة واحدة فقط
        || (signedIn() && request.auth.uid == uid
            && !setupDone() && setupDoneAfter()
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true
            && request.resource.data.username == 'admin')
      );

      // المدير يعدّل الآخرين؛ ولا يستطيع إيقاف نفسه أو سحب صلاحية المدير من نفسه
      allow update: if (isAdmin()
          && validProfile(request.resource.data, uid)
          && request.resource.data.username == resource.data.username
          && (uid != request.auth.uid
              || (request.resource.data.role == 'admin' && request.resource.data.active == true)))
        // المستخدم نفسه يستطيع فقط إلغاء علامة "يجب تغيير كلمة المرور" بعد تغييرها
        || (signedIn() && request.auth.uid == uid
            && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);

      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ربط اسم المستخدم بحساب الدخول؛ يُقرأ مستند واحد بالاسم عند تسجيل الدخول ولا يمكن سرد القائمة
    match /usernames/{name} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if validUsername(name)
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.username == name
        && (isAdmin()
            || (request.method == 'create' && name == 'admin'
                && signedIn() && request.resource.data.uid == request.auth.uid
                && !setupDone() && setupDoneAfter()));
      allow delete: if false;
    }

    // مستند يثبت أن الإعداد الأول تم؛ يُقرأ قبل الدخول لمعرفة إن كان حساب المدير موجودًا
    match /meta/setup {
      allow get: if true;
      allow create: if signedIn() && !setupDone()
        && request.resource.data.keys().hasOnly(['adminUid', 'at'])
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && getAfter(/databases/$(database)/documents/usernames/admin).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // سجل العمليات المشترك
    match /meta/audit {
      allow read: if isOffice();
      allow write: if isOffice()
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
    }

    // ملخص الإحصائيات القديم المستورد من Excel (إجماليات فقط، بلا بيانات مرضى)
    match /meta/history {
      allow read: if isOffice();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['data']);
    }

    // رحلات ملفات Excel للإحصائيات: مستند لكل يوم، بلا أسماء أو أرقام مرضى
    match /statsDays/{date} {
      allow read: if hasRole(['admin', 'fleetSupervisor']);
      allow create, update: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'source', 'importedAt', 'trips'])
        && request.resource.data.date == date
        && request.resource.data.source is string && request.resource.data.source.size() <= 200
        && request.resource.data.trips is list && request.resource.data.trips.size() <= 3000;
      allow delete: if isAdmin();
    }

    // الخانات التي تغيّرت في هذا التعديل
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function changes(key) { return changedKeys().hasAny([key]); }

    function appointmentStatuses() {
      return ['بانتظار طلب السيارة', 'تم طلب السيارة', 'تم استلام المريض', 'طلب عودة', 'مكتملة'];
    }
    function appointmentFields() {
      return ['id', 'patientName', 'clinic', 'buildingNumber', 'apartmentNumber', 'mobile', 'appointmentDate',
        'appointmentAt', 'hospitalId', 'category', 'kind', 'assistance', 'status', '_o'];
    }
    function validAppointment(data, id) {
      return data.keys().hasOnly(appointmentFields())
        && data.keys().hasAll(['id', 'patientName', 'clinic', 'appointmentDate', 'appointmentAt', 'kind', 'status'])
        && data.id == id
        && data.patientName is string && data.patientName.size() <= 120
        && data.clinic is string && data.clinic.size() <= 160
        && data.appointmentDate is string && data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.appointmentAt is string && data.appointmentAt.matches('^[0-9]{2}:[0-9]{2}$')
        && data.kind in ['عادي', 'احتياجات خاصة']
        && data.status in appointmentStatuses()
        && data.get('category', 'غير طبية') == 'غير طبية'
        && data.get('assistance', []) is list && data.get('assistance', []).size() <= 4;
    }

    // المواعيد: تضيفها وتعدّلها العيادة، ومشرف المبنى يغيّر حالتها فقط
    match /appointments/{id} {
      allow read: if isOffice();
      allow create: if validAppointment(request.resource.data, id) && (hasRole(['admin', 'clinic'])
        // مشرف السيارات يضيف رحلات غير طبية فقط
        || (hasRole(['fleetSupervisor']) && request.resource.data.get('category', '') == 'غير طبية'));
      allow update: if reasonableSize() && (
        (hasRole(['admin', 'clinic'])
          && changedKeys().hasOnly(appointmentFields())
          && !changes('id')
          && request.resource.data.status in appointmentStatuses())
        // مشرف المبنى لا يغيّر بيانات المريض ولا وقت الموعد، بل حالة الموعد فقط
        || (hasRole(['buildingSupervisor'])
          && changedKeys().hasOnly(['status'])
          && request.resource.data.status in appointmentStatuses()));
      allow delete: if hasRole(['admin', 'clinic']);
    }

    function requestStatuses() { return ['بانتظار التوزيع', 'تم إرسال السيارة', 'وصلت السيارة', 'تم استلام المريض']; }
    function requestFields() {
      return ['id', 'appointmentId', 'vehiclePlate', 'driver', 'direction', 'status', 'notificationMethod',
        'createdAt', 'groupId', 'notificationSentAt', '_o'];
    }

    // طلبات السيارات: ينشئها مشرف المبنى، ويوزعها مشرف السيارات
    match /requests/{id} {
      allow read: if isOffice();
      // الطلب الجديد يبدأ دائمًا بانتظار التوزيع، والسيارة يحددها مشرف السيارات لاحقًا
      allow create: if hasRole(['admin', 'buildingSupervisor', 'fleetSupervisor'])
        && request.resource.data.keys().hasOnly(requestFields())
        && request.resource.data.id == id
        && request.resource.data.appointmentId is string
        && request.resource.data.direction in ['ذهاب', 'عودة']
        && request.resource.data.status == 'بانتظار التوزيع'
        && request.resource.data.notificationMethod in ['whatsapp', 'call']
        && !request.resource.data.keys().hasAny(['vehiclePlate', 'driver', 'groupId', 'notificationSentAt']);
      allow update: if reasonableSize() && (
          (hasRole(['admin'])
            && changedKeys().hasOnly(requestFields())
            && !changedKeys().hasAny(['id', 'appointmentId'])
            && request.resource.data.status in requestStatuses())
          // مشرف السيارات: إرسال السيارة وجمع الرحلات
          || (hasRole(['fleetSupervisor'])
            && changedKeys().hasOnly(['vehiclePlate', 'driver', 'status', 'groupId', 'notificationSentAt'])
            && (!changes('status') || request.resource.data.status == 'تم إرسال السيارة'))
          // مشرف المبنى: تأكيد وصول السيارة واستلام المريض فقط
          || (hasRole(['buildingSupervisor'])
            && changedKeys().hasOnly(['status'])
            && request.resource.data.status in ['وصلت السيارة', 'تم استلام المريض'])
        );
      allow delete: if hasRole(['admin', 'buildingSupervisor']);
    }

    // السيارات: المدير يعدّل كل البيانات، ومشرف السيارات يغيّر حالة الإتاحة فقط
    match /fleet/{plate} {
      allow read: if isOffice();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['plate', 'driver', 'phone', 'kind', 'available', '_o'])
        && request.resource.data.plate == plate
        && request.resource.data.kind in ['سيدان', 'احتياجات خاصة', 'باص'];
      allow update: if hasRole(['fleetSupervisor'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available'])
        && request.resource.data.available is bool;
      allow delete: if isAdmin();
    }

    // دليل المستشفيات: يقرؤه الموظفون ويعدّله المدير
    match /hospitals/{id} {
      allow read: if isOffice();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name', 'nameEn', 'zone', 'lat', 'lng', 'aliases', 'verified', '_o'])
        && request.resource.data.id == id
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.lat is number && request.resource.data.lat > 24 && request.resource.data.lat < 27
        && request.resource.data.lng is number && request.resource.data.lng > 50 && request.resource.data.lng < 52.5
        && request.resource.data.aliases is list && request.resource.data.aliases.size() <= 40;
      allow delete: if isAdmin();
    }

    // مواقع GPS: كل سائق يكتب موقع سيارته فقط، ويقرؤها موظفو المكتب
    match /vehicleLocations/{plate} {
      allow read: if isOffice();
      allow create, update: if hasRole(['driver'])
        && profile().vehiclePlate == plate
        && request.resource.data.keys().hasOnly(['plate', 'lat', 'lng', 'accuracy', 'speed', 'heading', 'driver', 'sharing', 'updatedAt'])
        && request.resource.data.plate == plate
        && request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.sharing is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin();
    }
  }
}
